    {
      "name": "sb_view_open",
      "description": "Open existing entries or one step in an explicit existing pane. Requires view scope. Select exactly one of entryIds or stepId; mode is grid or overlay.",
      "scope": "view",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paneId",
          "mode"
        ],
        "properties": {
          "paneId": {
            "$ref": "#/$defs/id"
          },
          "entryIds": {
            "$ref": "#/$defs/ids"
          },
          "stepId": {
            "$ref": "#/$defs/id"
          },
          "mode": {
            "enum": [
              "grid",
              "overlay"
            ]
          },
          "cols": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "split": {
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "required": [
              "entryIds"
            ],
            "not": {
              "required": [
                "stepId"
