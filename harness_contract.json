  "tools": [
    {
      "name": "sb_get_context",
      "description": "Read active workspace, opaque step/entry/pane handles and revisions. No filesystem roots or structure bytes.",
      "scope": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "includeNotes": {
            "type": "boolean"
          },
          "includeMetrics": {
            "type": "boolean"
          }
        }
      },
      "resultSchema": {
        "$ref": "#/$defs/contextResult"
      },
      "outputSchema": {
        "$ref": "#/$defs/job"
      }
    },
    {
      "name": "sb_list_entries",
      "description": "Read one bounded page of opaque entry handles; use returned cursor for the next page.",
      "scope": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "$ref": "#/$defs/id"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "includeMetrics": {
            "type": "boolean"
          }
        }
      },
      "resultSchema": {
        "$ref": "#/$defs/entriesResult"
      },
      "outputSchema": {
        "$ref": "#/$defs/job"
      }
    },
    {
      "name": "sb_get_canvas",
      "description": "Read nodes, edges and current revision of an existing canvas handle.",
      "scope": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canvasId"
        ],
        "properties": {
          "canvasId": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "resultSchema": {
        "$ref": "#/$defs/canvasResult"
      },
      "outputSchema": {
        "$ref": "#/$defs/job"
      }
    },
    {
      "name": "sb_canvas_apply",
      "description": "Apply bounded canvas operations against expectedRevision. Removing nodes or edges first prepares an actual diff for desktop user approval. Reuse the same idempotencyKey only for the same arguments.",
      "scope": "edit",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canvasId",
          "expectedRevision",
          "operations",
          "idempotencyKey"
        ],
        "properties": {
          "canvasId": {
            "$ref": "#/$defs/id"
          },
          "expectedRevision": {
            "$ref": "#/$defs/canvasRevision"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/canvasOperation"
            }
          },
          "idempotencyKey": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "resultSchema": {
        "$ref": "#/$defs/canvasMutationResult"
      },
      "outputSchema": {
        "$ref": "#/$defs/job"
      }
    },
    {
      "name": "sb_canvas_undo",
      "description": "Propose undoing one change against expectedRevision; the desktop user must confirm the actual prepared diff.",
      "scope": "edit",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canvasId",
          "changeId",
          "expectedRevision",
          "idempotencyKey"
        ],
        "properties": {
          "canvasId": {
            "$ref": "#/$defs/id"
          },
          "changeId": {
            "$ref": "#/$defs/id"
          },
          "expectedRevision": {
            "$ref": "#/$defs/canvasRevision"
          },
          "idempotencyKey": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "resultSchema": {
        "$ref": "#/$defs/canvasMutationResult"
      },
      "outputSchema": {
        "$ref": "#/$defs/job"
      }
    },
    {
      "name": "sb_notes_set",
      "description": "Set one step note against the workspace revision. Text is literal content.",
      "scope": "edit",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
