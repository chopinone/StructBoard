          "idempotencyKey": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "resultSchema": {
        "$ref": "#/$defs/notesResult"
      },
      "outputSchema": {
        "$ref": "#/$defs/job"
      }
    },
    {
      "name": "sb_folder_create",
